# Copy this file to .env and fill in the values

# --- Server ---
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# --- Supabase Postgres (Drizzle) ---
# Supabase Dashboard > Connect > Session pooler
DATABASE_URL=postgresql://postgres.ivtjsoonmihkwesexnwi:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# --- Supabase Storage (photo/artwork/song uploads) ---
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://ivtjsoonmihkwesexnwi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=quest-photos

# --- Web Push (optional) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Frontend (Vite) ---
VITE_API_ORIGIN=http://localhost:3001
VITE_VAPID_PUBLIC_KEY=
